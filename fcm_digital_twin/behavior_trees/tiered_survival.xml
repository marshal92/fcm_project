<root BTCPP_format="4" main_tree_to_execute="MainTree">
    <BehaviorTree ID="MainTree">
        <Sequence name="Emergency_Survival_Protocol">
            <Wait wait_duration="10.0" />
            <ClearEntireCostmap name="ClearLocal" service_name="local_costmap/clear_entirely_local_costmap" server_timeout="5000"/>
            <ClearEntireCostmap name="ClearGlobal" service_name="global_costmap/clear_entirely_global_costmap" server_timeout="5000"/>
            <SubTree ID="SafeNavigation" _autoremap="true" target_goal="{goal}" />
        </Sequence>
    </BehaviorTree>

    <BehaviorTree ID="SafeNavigation">
        <RecoveryNode number_of_retries="6" name="NavigateRecovery">
            <PipelineSequence name="Drive">
                <RateController hz="1.0">
                    <ComputePathToPose goal="{target_goal}" path="{path}" planner_id="GridBased"/>
                </RateController>
                <FollowPath path="{path}" controller_id="FollowPath"/>
            </PipelineSequence>
            <Sequence name="RecoveryActions">
                <ClearEntireCostmap service_name="local_costmap/clear_entirely_local_costmap"/>
                <ClearEntireCostmap service_name="global_costmap/clear_entirely_global_costmap"/>
                <Wait wait_duration="0.2"/> 
                <Fallback name="BackupOrSpin">
                    <BackUp backup_dist="0.4" backup_speed="0.15"/>
                    <Spin spin_dist="1.57"/>
                </Fallback>
            </Sequence>
        </RecoveryNode>
    </BehaviorTree>
</root>